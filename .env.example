# Solana Prediction Paper-Trading Bot — environment variables (copy to .env)

# --- Required ---
# WebSocket/RPC endpoint for the market feed (e.g. Helius RPC URL).
# Required for boot; unused in sim / kalshi modes beyond validation.
RPC_URL=

# Market + feed mode:
#   'sim'    -> built-in simulated BTC YES/NO order book (default)
#   'real'   -> live Drift B.E.T oracle via Helius RPC WebSocket
#   'kalshi' -> live Kalshi KXBTC15M 15-minute BTC Up/Down contracts
# MARKET_MODE=sim
MARKET_MODE=sim

# Primary asset to trade (used for market naming, the sim price model, and the
# Drift B.E.T market filter). Default BTC.
TARGET_ASSET=BTC

# --- Kalshi feed (MARKET_MODE=kalshi) ---
# Public Kalshi trade-api base + series. The feed polls the active 15-minute
# contract and papers-fills against its live bid/ask. No API key needed for
# reads; real order placement requires KALSHI_API_KEY/SECRET (not wired).
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_SERIES=KXBTC15M
KALSHI_POLL_MS=5000
KALSHI_FETCH_TIMEOUT=8000

# Live BTC spot price (Coinbase public) used for momentum + dashboard BTC row.
BTC_SPOT_POLL_MS=1000

# --- Real-feed adapter (Drift B.E.T / Prediction markets) ---
# Optional: pin the Drift perp market index to quote. If unset, the first
# ACTIVE prediction market matching TARGET_ASSET is auto-selected.
DRIFT_MARKET_INDEX=
# Half-spread used to derive bid/ask around the live oracle YES price (0..1).
DRIFT_SPREAD_FALLBACK=0.03
# How often (ms) to re-scan for a TARGET_ASSET B.E.T market when none is live.
DRIFT_MARKET_SCAN_MS=60000

# --- Legacy raw-account adapter (unused; retained for reference) ---
MARKET_PROGRAM_ID=
MARKET_ACCOUNTS=

# --- Risk Management (TP/SL) ---
# Defaults when no saved config exists. The dashboard toggles + inputs override
# these live (persisted to Supabase bot_settings) — no restart needed.
# Early cash-out when floating PnL >= TP_VALUE  (reason: tp_exit)
TP_ENABLED=false
TP_VALUE=0.50
# Early cash-out when floating PnL <= SL_VALUE (reason: sl_exit)
SL_ENABLED=false
SL_VALUE=-0.60
# Optional: require this key on X-Api-Key for POST /api/risk. Empty = allow.
API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Feed tuning (defaults are fine) ---
FEED_INTERVAL_MS=200
SIMS_SPREAD_MIN=0.02
SIMS_SPREAD_MAX=0.06
SIMS_MOMENTUM_SHOCK_PROB=0.002
SIMS_BTC_START_PRICE=67000
SIMS_BTC_SIGMA=0.0002
SIMS_BTC_DRIFT=0

# Window duration (informational for Kalshi mode — the active KXBTC15M
# contract's close_time is authoritative there).
MARKET_DURATION_MS=300000

# --- Engine: BTC momentum signal ---
# momentum = (avg last 60s price - avg prior 60s price) / prior avg.
MOMENTUM_THRESHOLD=0.0005
MOMENTUM_LOOKBACK_MS=60000