# Solana Prediction Paper-Trading Bot — environment variables (copy to .env)

# --- Required ---
# WebSocket/RPC endpoint for the market feed (e.g. Helius RPC URL).
RPC_URL=

# Feed data source: 'sim' (built-in simulated YES/NO order book) or 'real' (live Helius RPC subscriptions).
MARKET_MODE=sim

# --- Real-feed adapter (Phase 8) ---
# Program ID owning the target prediction-market order book accounts.
MARKET_PROGRAM_ID=
# Comma-separated public keys of the YES/NO order book / market accounts to subscribe to.
MARKET_ACCOUNTS=

# --- Telegram ---
# Required: BotFather bot token.
TELEGRAM_BOT_TOKEN=
# Optional: grab the destination automatically — DM the bot with /start and the
# bot learns your chat id. Only set this to override auto-discovery.
TELEGRAM_CHAT_ID=

# --- Feed tuning (defaults are fine) ---
# Feed tick interval in milliseconds (both adapters).
FEED_INTERVAL_MS=200
# Sim feed spread range (dollars) quoted around the mid price.
SIMS_SPREAD_MIN=0.02
SIMS_SPREAD_MAX=0.06
# Sim feed mean-reversion & volatility knobs.
SIMS_KAPPA=0.01
SIMS_SIGMA=0.02
SIMS_MOMENTUM_SHOCK_PROB=0.002

# Duration of one prediction market window in milliseconds (default 5 minutes).
MARKET_DURATION_MS=300000