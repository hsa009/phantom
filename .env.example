# Solana Prediction Paper-Trading Bot — environment variables (copy to .env)

# --- Required ---
# WebSocket/RPC endpoint for the market feed (e.g. Helius RPC URL).
RPC_URL=

# Feed data source: 'sim' (built-in simulated YES/NO order book) or 'real' (live Drift B.E.T oracle via Helius RPC WebSocket).
MARKET_MODE=sim

# Primary asset to trade (used for market naming, the sim price model, and the
# Drift B.E.T market filter). Default BTC.
TARGET_ASSET=BTC

# --- Real-feed adapter (Drift B.E.T / Prediction markets) ---
# Optional: pin the Drift perp market index to quote. If unset, the first
# ACTIVE prediction market matching TARGET_ASSET is auto-selected.
DRIFT_MARKET_INDEX=
# Half-spread used to derive bid/ask around the live oracle YES price (0..1).
DRIFT_SPREAD_FALLBACK=0.03
# How often (ms) to re-scan for a TARGET_ASSET B.E.T market when none is live.
DRIFT_MARKET_SCAN_MS=60000
# NOTE: in 'real' mode RPC_URL must be a mainnet Helius key that supports
# WebSocket accountSubscribe. DriftFeed only trades markets whose name matches
# TARGET_ASSET — with no such market live it logs and stays idle (no simulated
# data, no trades) until one lists.

# --- Legacy raw-account adapter (unused; retained for reference) ---
# Program ID owning the target prediction-market order book accounts.
MARKET_PROGRAM_ID=
# Comma-separated public keys of the YES/NO order book / market accounts to subscribe to.
MARKET_ACCOUNTS=

# --- Telegram ---
# Required: BotFather bot token.
TELEGRAM_BOT_TOKEN=
# Optional: grab the destination automatically — DM the bot with /start and the
# bot learns your chat id. Only set this to override auto-discovery.
TELEGRAM_CHAT_ID=

# --- Feed tuning (defaults are fine) ---
# Feed tick interval in milliseconds (both adapters).
FEED_INTERVAL_MS=200
# Sim feed spread range quoted around the mid (probability) price.
SIMS_SPREAD_MIN=0.02
SIMS_SPREAD_MAX=0.06
# Sim feed: occasional jump shock to the BTC price (creates tradable momentum).
SIMS_MOMENTUM_SHOCK_PROB=0.002
# --- Sim feed: BTC spot-price model (TARGET_ASSET=BTC) ---
# Starting BTC price ($).
SIMS_BTC_START_PRICE=67000
# Per-tick standard deviation of BTC returns (~0.5-1% total per 5-min window).
SIMS_BTC_SIGMA=0.0002
# Per-tick drift of BTC returns (0 = no bias).
SIMS_BTC_DRIFT=0

# Duration of one prediction market window in milliseconds (default 5 minutes).
MARKET_DURATION_MS=300000

# --- Engine: BTC momentum signal ---
# momentum = (avg last 60s price - avg prior 60s price) / prior avg.
# MOMENTUM_THRESHOLD is that return as a fraction (0.0005 = 0.05% per 60s).
MOMENTUM_THRESHOLD=0.0005
MOMENTUM_LOOKBACK_MS=60000